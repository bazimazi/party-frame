{
  "name": "party-frame",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "TV-plus-phones party-game framework. Shared screen is the game; phones are the controllers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazimazi/party-frame.git"
  },
  "homepage": "https://github.com/bazimazi/party-frame#readme",
  "bugs": {
    "url": "https://github.com/bazimazi/party-frame/issues"
  },
  "keywords": [
    "party-game",
    "multiplayer",
    "colyseus",
    "phaser",
    "controller"
  ],
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "npm run build -w @party-frame/protocol -w @party-frame/game-core -w @party-frame/runtime -w @party-frame/kit -w @party-frame/i18n --if-present",
    "dev": "npm run dev -w @party-frame/protocol -w @party-frame/game-core -w @party-frame/runtime -w @party-frame/kit -w @party-frame/i18n --if-present",
    "typecheck": "npm run typecheck -w @party-frame/protocol -w @party-frame/game-core -w @party-frame/runtime -w @party-frame/kit -w @party-frame/i18n --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npm run build && npm run dev -w @party-frame/example-minimal"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
